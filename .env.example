# Copy to .env and adjust. Every value has a default in docker-compose.yml.

# Where data is stored on the host (PostgreSQL cluster, Zarr rasters, raw downloads)
GEOMON_DATA_DIR=./data

# Area of interest: one or more INSEE commune codes, comma-separated. Data is downloaded once
# for their joint extent; each commune and the group can be analysed.
# Montseveroux = 38259, Monsteroux-Milieu = 38244, Chalon = 38066.
GEOMON_COMMUNES=38259
# For a group: a short code (used in file names) and a display name. Defaults: grp-<codes>,
# and the commune names.
GEOMON_SITE_CODE=
GEOMON_SITE_NAME=
# Extra margin around the commune for downloads, in metres
GEOMON_AOI_BUFFER_M=1000

# Source vintages
GEOMON_COG_VINTAGE=2026
GEOMON_RPG_LAYER=RPG.LATEST
GEOMON_RPG_YEAR=2025

# Several sites on one server: list them in <data dir>/sites.json (see README, "Sites"); the
# GEOMON_COMMUNES / GEOMON_SITE_* / GEOMON_FARM_* values below are then ignored.
# GEOMON_SITES_FILE=sites.json

# Optional: the farm's own plots (GeoJSON in WGS84, e.g. a PAC export), relative to the data directory.
# They become an analysis area ("My plots"): land summary, weather, Sentinel-2 and crop groups.
# GEOMON_FARM_FILE=farm/parcellaire_pac_wgs84.geojson
# GEOMON_FARM_NAME=My plots
# Earlier years (RPG.<year> layers) are loaded too, for the crop history of the parcels
GEOMON_RPG_FIRST_YEAR=2015

# Raster resolutions (metres, Lambert-93)
GEOMON_DEM_RES_M=5
GEOMON_SOIL_RES_M=250

# Weather (Open-Meteo, Météo-France SIM2). Météo-France archived forecasts start on 2022-11-13
# at Open-Meteo; ERA5-Land starts at GEOMON_WEATHER_START.
GEOMON_WEATHER_START=2022-01-01
# SIM2 is kept from this date, for the 1991-2020 daily normals
GEOMON_SIM2_START=1990-01-01
# Shortest time between two forecast downloads (hours): each counts once per grid point at Open-Meteo
GEOMON_FORECAST_MIN_HOURS=3
# ERA5-Land: preliminary data is replaced by the final release 2-3 months later; the last
# GEOMON_ERA5_REVISION_DAYS are fetched again every GEOMON_ERA5_REVISION_EVERY_DAYS to pick up the corrections
GEOMON_ERA5_REVISION_DAYS=92
GEOMON_ERA5_REVISION_EVERY_DAYS=7
# Spacing of the Open-Meteo points over the AOI, in degrees (0.025 = AROME 2.5 km grid)
GEOMON_WEATHER_GRID_DEG=0.025
# Open-Meteo is free for non-commercial use. A commercial subscription key goes here.
GEOMON_OPENMETEO_API_KEY=
# AgERA5 (Copernicus CDS): free account, personal access token from
# https://cds.climate.copernicus.eu/profile. Accept the licence once on
# https://cds.climate.copernicus.eu/datasets/sis-agrometeorological-indicators?tab=download
# Without a token the agera5 step is skipped.
GEOMON_CDS_API_KEY=
# AgERA5 is downloaded from this date (full history: 1979-01-01)
GEOMON_AGERA5_START=1979-01-01

# Sentinel-2 L2A through openEO (Copernicus Data Space Ecosystem, free account). Log in once with
#   docker compose run --rm ingest sentinel2-login
# Spectral bands kept besides the scene classification (SCL): B04,B08 give NDVI; add B05 for NDRE
# (or any of B01-B12, B8A). Added bands are fetched for the whole history at the next run.
GEOMON_S2_BANDS=B04,B08
GEOMON_S2_START=2015-06-27
# Scenes whose tile cloud cover exceeds this percentage are not downloaded
GEOMON_S2_MAX_CLOUD=80
# Parcel time series use a parcel on a date when at least this share of its interior is clear
GEOMON_S2_PARCEL_MIN_CLEAR=0.8
# Daily parcel curves: none (linear interpolation between clear dates) or whittaker (smoothed upper
# envelope, lowers the weight of dates far below the curve). Run ingest sentinel2-parcels after a change.
GEOMON_S2_PARCEL_SMOOTHING=none

# OpenStreetMap source: overpass (AOI only, a few MB) or geofabrik (regional extract, 533 MB
# for Rhône-Alpes; kept for later, larger areas). Downloads are reused for OSM_MAX_AGE_DAYS.
GEOMON_OSM_SOURCE=overpass
# Comma-separated Overpass endpoints, tried in order
GEOMON_OVERPASS_URLS=https://overpass-api.de/api/interpreter
GEOMON_OSM_PBF_URL=https://download.geofabrik.de/europe/france/rhone-alpes-latest.osm.pbf
GEOMON_OSM_MAX_AGE_DAYS=30

# Ports on the host (bound to 127.0.0.1 only)
GEOMON_WEB_PORT=8088
GEOMON_DB_PORT=5433

# Database credentials (local use only)
POSTGRES_DB=geomon
POSTGRES_USER=geomon
POSTGRES_PASSWORD=geomon
